# Talk to Your Context — example environment.
# Copy to `.env` and fill in. Never commit `.env`.

# --- OpenAI Realtime ---------------------------------------------------------
# Used to mint ephemeral session keys server-side; the browser never sees this.
OPENAI_API_KEY=
# gpt-realtime-2 (May 2026 GA): GPT-5-class reasoning, 128K context, native
# preambles + async function calling. Use the legacy `gpt-realtime` only if you
# need to roll back to the pre-cutover behavior.
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=alloy

# --- Backend agent -----------------------------------------------------------
# The sidecar reaches your agent backend at this base URL for the slow path:
# `deep_research`, dossier refresh, post-call working-state extraction, and the
# /api/text-turn channel. All fast/narrow tools dispatch locally and never call
# this endpoint. Expected contract: OpenAI-style POST /v1/chat/completions SSE.
#
# Quickstart-without-backend: set to `stub://` to use the bundled in-process
# stub (backends/stub_agent.py) that returns canned responses good enough to
# smoke-test the full voice + tool + deep_research flow.
AGENT_API_BASE=stub://
# Bearer token for the agent. Alternative: drop the key into a sibling file
# called `.agent-api-key` (chmod 600) and leave this blank.
AGENT_API_KEY=

# --- Sidecar listener --------------------------------------------------------
VOICE_HOST=127.0.0.1
VOICE_PORT=8090
# Comma-separated CIDR allowlist. Default is loopback only.
# Example for Tailscale CGNAT: 100.64.0.0/10,127.0.0.1/32,::1/128
VOICE_ALLOWED_CIDR=127.0.0.1/32,::1/128

# --- deep_research timeout ---------------------------------------------------
# Total wall-clock cap on a single deep_research stream from the backend. The
# model fills the wait via native preambles + async function calling, so this
# only bounds the absolute worst case (backend hung, network wedged, etc.).
ASK_AGENT_TIMEOUT_SEC=600
# Read-watchdog: if the backend goes silent for this long mid-stream, the
# sidecar surfaces a structured "agent unreachable" error.
ASK_AGENT_IDLE_TIMEOUT_SEC=45

# --- Transcripts -------------------------------------------------------------
TRANSCRIPT_DIR=./transcripts

# --- Dossier (today's standing context) --------------------------------------
# Path to the structured-dossier JSON injected into every session's
# instructions (today's calendar/loops/decisions/hot people + the working
# state extracted from the previous call). Regenerated on server boot and
# after every call ends. Date-gated: a dossier from yesterday is treated as
# stale and skipped at mint.
#
# Leave empty for stranger/quickstart deployments — the dossier is optional;
# the voice chat still works without it. Personal deployments wire this to a
# JSON file produced by their own agent (see "Personal deployment example"
# block below).
DOSSIER_PATH=
# IANA TZ name used to decide "is this dossier today's?"
DOSSIER_TZ=America/New_York

# --- Memory sources (optional, env-driven registry) --------------------------
# Each of these is OPTIONAL. The mint pathway iterates this registry and
# prepends configured blocks to Realtime session instructions. Empty/unset =
# silently skipped. Public default is empty; a personal deployment can wire
# any subset to local memory files (markdown). VOICE_PATH is the only file
# the voice chat WRITES to (post-call learnings extractor); the others are
# read-only.
#
# Each *_HEADER override is optional and sets the "## …" block label that
# appears in instructions; defaults are generic ("User profile", etc.).
VOICE_MEMORY_USER_PROFILE_PATH=
VOICE_MEMORY_USER_PROFILE_HEADER=
VOICE_MEMORY_SHARED_PATH=
VOICE_MEMORY_SHARED_HEADER=
VOICE_MEMORY_VOICE_PATH=
VOICE_MEMORY_VOICE_HEADER=
# JSON file mapping recent conv_ids to one-line summaries. Surfaced as a
# compact map in instructions so the model can call `recall_recent_call` on
# any prior call. Empty = no map (model gets fresh-start for each session).
VOICE_MEMORY_TRANSCRIPT_INDEX_PATH=

# --- Optional: Slack archive of voice calls ----------------------------------
# Leave blank to disable. If set, each ended call posts a headline + threaded
# transcript to the configured channel.
SLACK_BOT_TOKEN=
SLACK_CALL_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Personal deployment example (uncomment and adapt if you already run a
# personal-assistant agent with its own memory bank on this host):
# -----------------------------------------------------------------------------
# AGENT_API_BASE=http://127.0.0.1:8642
# DOSSIER_PATH=~/.your-agent/dossier/today.json
# VOICE_MEMORY_USER_PROFILE_PATH=~/.your-agent/memories/USER.md
# VOICE_MEMORY_USER_PROFILE_HEADER=Who I am
# VOICE_MEMORY_SHARED_PATH=~/.your-agent/memories/MEMORY.md
# VOICE_MEMORY_SHARED_HEADER=Assistant core memory
# VOICE_MEMORY_VOICE_PATH=~/.your-agent/memories/VOICE.md
# VOICE_MEMORY_TRANSCRIPT_INDEX_PATH=~/.your-agent/memories/voice_transcript_index.json
